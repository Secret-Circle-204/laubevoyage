# ==============================================================================
# L'Aube Voyage - Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and supply actual production secrets.
# NEVER commit real credentials to version control.

# Application & Public URLs
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgres://user:password@hostname:5432/database_name?sslmode=require

# Payload CMS Core Secret (Generate with: openssl rand -hex 32)
PAYLOAD_SECRET=your_32_byte_hex_payload_secret_here

# Payment Gateway - Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Cron Job Authorization Secret (Bearer Token)
CRON_SECRET=your_secure_random_cron_secret_token

# SMTP Email Transport (Transactional Emails & Verification)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
FROM_EMAIL=concierge@laubevoyage.com
FROM_NAME="L'Aube Voyage Luxury Concierge"

# Node Environment
NODE_ENV=production

# Background Worker Leases & Processing
DISABLE_BG_WORKERS=false

# Multi-Node / Next.js ISR Cache Revalidation Secret
INTERNAL_REVALIDATION_TOKEN=your_secure_random_internal_revalidation_token

# ==============================================================================
# Translation Engine & Multi-Cloud Provider Pool (Placeholders - No Secrets)
# ==============================================================================
# 1. Microsoft Azure Translator (Cognitive Services)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# 2. Google GTX Keyless Helper (Optional Opportunistic Fallback - Opt-In)
# ENABLE_GOOGLE_GTX=false

# 3. Cloudflare Workers AI (Model: @cf/meta/m2m100-1.2b - Reliability Fallback)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=


